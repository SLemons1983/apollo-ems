# Copy to .env.local for local development. Use STAGING values only.
# Builds that are not production refuse to use the production Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://eejahcuftznsabulssew.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APOLLO_OWNER_EMAILS=
# Outside production, email goes only to these addresses or @domains.
APOLLO_NONPRODUCTION_EMAIL_ALLOWLIST=@example.test
# Leave unset: SMS is always disabled outside production; CAD stays disabled
# unless this is set to true for a NON-production CAD instance.
# APOLLO_ALLOW_NONPRODUCTION_CAD=
# Local database tests (scripts/local-test-db.sh start prints this):
# TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:54329/postgres
